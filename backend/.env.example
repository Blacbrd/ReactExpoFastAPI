# Copy to .env and fill in. Never commit .env.

APP_NAME="Hackathon API"
ENVIRONMENT=development

# JSON list. Expo dev server runs on 8081; "*" is fine for a hackathon.
CORS_ORIGINS=["*"]

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Newest free-tier Flash model. Check https://ai.google.dev/gemini-api/docs/models when a new one drops.
GEMINI_MODEL=gemini-3.8-flash
